ENTRY(_RESET_ENTRY)
SECTIONS
{
    . = DEFINED(TLK_MW_USER_CTRL_ENABLE_VALUE) ? 0x20013040 : 0x20000000;
    PROVIDE (BIN_BEGIN = .);
    .vectors        : { KEEP(*(.vectors )) }

    . = 0x82039800;
	PROVIDE (_DSP_SHARE_MEM_VMA_START = .);
	.dsp_share_mem (NOLOAD): { KEEP(*(.dsp_share_mem )) }
	PROVIDE (_DSP_SHARE_MEM_VMA_END = .);
	
	. = 0x8203e800;
	PROVIDE (_DSP_SHARE_MEM_ANC_MIC_VMA_START = .);
	.dsp_share_mem_anc_mic 	(NOLOAD)	: {KEEP(*(.dsp_share_mem_anc_mic )) }
	PROVIDE (_DSP_SHARE_MEM_ANC_MIC_VMA_END = .);
	
	. = 0x8203f400;
	PROVIDE (_DSP_SHARE_MEM_ANC_SPK_VMA_START = .);
	.dsp_share_mem_anc_spk 	(NOLOAD)	: {KEEP(*(.dsp_share_mem_anc_spk )) }
	PROVIDE (_DSP_SHARE_MEM_ANC_SPK_VMA_END = .);
	
    . = 0x00020000;
    .retention_reset    : AT( ALIGN(LOADADDR (.vectors) + SIZEOF (.vectors),8)) 
        { KEEP(*(.retention_reset )) }
    PROVIDE (_RETENTION_RESET_VMA_START = ADDR(.retention_reset));
    PROVIDE (_RETENTION_RESET_LMA_START = LOADADDR(.retention_reset));
    PROVIDE (_RETENTION_RESET_VMA_END = .); 
    
    . = 0x00020200;
	PROVIDE (_EXCHANGE_MEM_VMA_START = .);
	.exchange_mem (NOLOAD): { KEEP(*(.exchange_mem )) }
	PROVIDE (_EXCHANGE_MEM_VMA_END = .);
    
    /* By default,the aes_data section can only be used in the first 64K of IRAM, */
    /* please do not change the position of this section,unless you know the correct way to use */ 
    . = ALIGN(8);
    PROVIDE (_AES_VMA_START = .);
    .aes_data   (NOLOAD)    : { KEEP(*(.aes_data )) }
    PROVIDE (_AES_VMA_END = .);
    . = ALIGN(8);
    .retention_data : AT( ALIGN(LOADADDR (.retention_reset) + SIZEOF (.retention_reset),8)) 
        { KEEP(*(.retention_data )) }
    PROVIDE (_RETENTION_DATA_VMA_START = ADDR(.retention_data));
    PROVIDE (_RETENTION_DATA_LMA_START = LOADADDR(.retention_data));
    PROVIDE (_RETENTION_DATA_VMA_END = .); 
    
    . = ALIGN(8);
    .ram_code   : AT( ALIGN(LOADADDR (.retention_data) + SIZEOF (.retention_data),8)) 
        { KEEP(*(.ram_code )) }
    PROVIDE (_RAMCODE_VMA_START = ADDR(.ram_code));
    PROVIDE (_RAMCODE_LMA_START = LOADADDR(.ram_code));
    
    . = ALIGN(8);
    .alg_ram_code   : AT( ALIGN(LOADADDR (.ram_code) + SIZEOF (.ram_code),8)) 
        { 
        	KEEP(*(.ram_code_nn_ns))
        	KEEP(*(.lc3_ram_code))
        	KEEP(*(.opus_ram_code))
        }
    PROVIDE (_RAMCODE_VMA_END = .);
    PROVIDE (_RAMCODE_SIZE = SIZEOF (.alg_ram_code) + SIZEOF (.ram_code)); 
    
    . = ALIGN(8);
    .iram_data (NOLOAD): AT( ALIGN(LOADADDR (.alg_ram_code) + SIZEOF (.alg_ram_code),8))
        { KEEP(*(.iram_data )) }
    PROVIDE (IRAM_END = .);
    
    . = ALIGN(LOADADDR (.alg_ram_code) + SIZEOF (.alg_ram_code), 8);
    .text           : AT(ALIGN(LOADADDR (.alg_ram_code) + SIZEOF (.alg_ram_code), 8)) 
        { *(.text .stub .text.* .gnu.linkonce.t.* ) KEEP(*(.text.*personality* )) *(.gnu.warning )  }
    .rodata         : AT(ALIGN(LOADADDR (.text) + SIZEOF (.text), ALIGNOF(.rodata))) 
        { *(.rodata .rodata.* .gnu.linkonce.r.* )
         *(.srodata.cst16 ) *(.srodata.cst8 ) *(.srodata.cst4 ) *(.srodata.cst2 ) *(.srodata .srodata.* ) *(.sdata2 .sdata2.* .gnu.linkonce.s.* )
        }
    .eh_frame_hdr   : AT(ALIGN(LOADADDR (.rodata) + SIZEOF (.rodata), ALIGNOF(.eh_frame_hdr)))
        { *(.eh_frame_hdr ) }
    . = ALIGN(0x20);
    .eh_frame   : AT(ALIGN(LOADADDR (.eh_frame_hdr) + SIZEOF (.eh_frame_hdr), 32))
        { KEEP(*(.eh_frame )) }
        
    .exec.itable    : AT(ALIGN(LOADADDR (.eh_frame) + SIZEOF (.eh_frame), ALIGNOF(.exec.itable)))
        { KEEP(*(.exec.itable)) }
                
    . = 0x00080000;
    .dsp_share_mem_d25f         (NOLOAD)        : { . = .;   . = ALIGN(8); ; *(.dsp_share_mem_d25f )}
	PROVIDE (_DSP_DATA_MEM_VMA_START = ADDR(.dsp_share_mem_d25f));
	PROVIDE (_DSP_DATA_MEM_VMA_END = .);

    .dsp_share_mem_d25f1         (NOLOAD)        : { . = .;   . = ALIGN(8); ; *(.dsp_share_mem_d25f1 )}
	PROVIDE (_DSP_DATA1_MEM_VMA_START = ADDR(.dsp_share_mem_d25f1));
	PROVIDE (_DSP_DATA1_MEM_VMA_END = .);

    .dsp_share_mem_d25f2         (NOLOAD)        : { . = .;   . = ALIGN(8); ; *(.dsp_share_mem_d25f2 )}
	PROVIDE (_DSP_DATA2_MEM_VMA_START = ADDR(.dsp_share_mem_d25f2));
	PROVIDE (_DSP_DATA2_MEM_VMA_END = .);
	
    PROVIDE( __global_pointer$ = . + (4K / 2) );
    
	PROVIDE (_CONFIG_DATA_POS = ALIGN(LOADADDR (.exec.itable) + SIZEOF (.exec.itable),8) - BIN_BEGIN);
	.config_data : AT( ALIGN(LOADADDR (.exec.itable) + SIZEOF (.exec.itable),8) )
		{*(.config_data)}
	PROVIDE (_CONFIG_DATA_VMA_END = .);	
    PROVIDE (_CONFIG_DATA_VMA_START = ADDR(.config_data));
	PROVIDE (_CONFIG_DATA_LMA_START = LOADADDR(.config_data));	
	
    .data   : AT(ALIGN(LOADADDR (.config_data) + SIZEOF (.config_data),  ALIGNOF(.data)))
        { *(.data .data.* .gnu.linkonce.d.* ) KEEP(*(.gnu.linkonce.d.*personality* )) SORT(CONSTRUCTORS) 
         *(.sdata .sdata.* .gnu.linkonce.s.* )
        }
    PROVIDE (_DATA_VMA_START = ADDR(.data));
    PROVIDE (_DATA_LMA_START = LOADADDR(.data));
    
    .alg_data   : AT(ALIGN(LOADADDR (.data) + SIZEOF (.data),  ALIGNOF(.alg_data)))
        { 
	        KEEP(*(.opus_data))
         	KEEP(*(.ram_data_nn_ns))
         	KEEP(*(.lc3_data))
        }
    PROVIDE (_DATA_VMA_END = .);
    PROVIDE (BIN_SIZE = LOADADDR(.alg_data) + SIZEOF(.alg_data) - BIN_BEGIN);  
    
    . = ALIGN(8);
    PROVIDE (_BSS_VMA_START = .);
    .sbss   (NOLOAD)    : { *(.dynsbss ) *(.sbss .sbss.* .gnu.linkonce.sb.* ) *(.scommon .scommon.* ) }
    .bss    (NOLOAD)    : { *(.dynbss ) *(.bss .bss.* .gnu.linkonce.b.* ) *(COMMON ) . = ALIGN(8); }
    /* When using the S file _FILL_STK function (which clears all the values in the stack space to 0x55), 
     * if _BSS_VMA_END does not have four-byte alignment, there may be an out-of-bounds access beyond _STACK_TOP,
     * resulting in a store access fault.
     */
    PROVIDE (_BSS_VMA_END = ((. + 3) / 4)*4);
    
    .sdk_version  	: AT(LOADADDR (.alg_data) + SIZEOF (.alg_data))
		{ KEEP(*(.sdk_version )) }

	PROVIDE (BIN_SIZE = LOADADDR(.sdk_version) + SIZEOF(.sdk_version) - BIN_BEGIN);

    . = ALIGN(8);
    /* end is the starting address of the heap, the heap grows upward */
    _end = .;
    PROVIDE (end = .);      
    PROVIDE (_STACK_TOP = 0xe0000);
    PROVIDE (FLASH_SIZE = 0x0400000);
}

ASSERT((BIN_SIZE)<= FLASH_SIZE, "BIN FILE OVERFLOW");
